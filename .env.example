# Google Gemini Multimodal Vision API Key (Optional)
# If provided, enables cloud-based complex visual reasoning and detailed Bengali answers.
# If omitted, DRISHTI AI automatically uses on-device MediaPipe & Tesseract models 100% offline.
# Get a free key at: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=AIzaSy...

# Smart Cane IoT Gateway (Optional, defaults to http://127.0.0.1:5000)
NEXT_PUBLIC_SMART_CANE_SERVER_URL=http://127.0.0.1:5000
